{
  "name": "ehyleen-web",
  "version": "1.0.0",
  "description": "EHYLEEN · Paisajismo, Bioarquitectura y Jardinería de Alta Gama en Barranquilla",
  "main": "index.html",
  "scripts": {
    "start": "node -e \"const http=require('http'),fs=require('fs'),path=require('path');http.createServer((req,res)=>{let f=req.url==='/'?'index.html':req.url.slice(1);fs.readFile(f,(e,d)=>{if(e){res.writeHead(404);return res.end('Not Found')}res.writeHead(200);res.end(d)})}).listen(8097,()=>console.log('EHYLEEN corriendo en http://localhost:8097'))\""
  },
  "keywords": [
    "jardineria",
    "paisajismo",
    "barranquilla",
    "bioarquitectura",
    "viveros-aliados"
  ],
  "author": "EHYLEEN & Giselle Ulloa Architecture",
